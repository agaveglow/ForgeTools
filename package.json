{
  "name": "forgetools",
  "private": true,
  "version": "0.1.0",
  "description": "ForgeTools \u2014 personal IT engineering toolkit (work logs, troubleshooting, commands, security checklists, knowledge base, skills).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "offline:build": "bun scripts/build.ts",
    "offline:serve": "bun scripts/serve.ts",
    "offline:typecheck": "tsc --noEmit -p tsconfig.offline.json",
    "offline:e2e": "node tests/e2e.mjs",
    "offline:a11y": "node tests/a11y.mjs",
    "validate:content": "bun tools/validate-content.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}